# Copy to .env and replace placeholders using your secret manager.
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=replace-with-database-name
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ALLOWED_HOSTS=[]
MCP_AUTH_TOKEN=replace-with-a-long-random-token
LOG_LEVEL=INFO
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_COMMAND_TIMEOUT=30
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_WAIT_SECONDS=0.5
RETRY_MAX_WAIT_SECONDS=10.0
RETRY_MULTIPLIER=2.0
